# Copy to .env (gitignored). Values below match infra/docker-compose.yml for local development.

# Owner role: migrations and seed only.
DATABASE_URL=postgresql://ubos:ubos@localhost:5432/ubos
# Runtime role subject to row-level security (tenant API).
APP_DATABASE_URL=postgresql://ubos_app:ubos_app_dev@localhost:5432/ubos
# Runtime role that bypasses RLS (Platform Console API only).
PLATFORM_DATABASE_URL=postgresql://ubos_platform:ubos_platform_dev@localhost:5432/ubos

# Generate long random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_PLATFORM_SECRET=

# 32 bytes hex — encrypts 2FA secrets and integration credentials at rest
ENCRYPTION_KEY=

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000   # base of webhook URLs, form posts and the public API shown to users
# WEBHOOKS_DISABLED=true          # stop sending outgoing webhooks (queued deliveries wait)
# ALLOW_PRIVATE_WEBHOOKS=true     # production only: allow webhooks / sheet links to private addresses (off by default; always allowed in development)
WEB_ORIGIN=http://localhost:3030
# Web app → API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Email (local: Mailpit from infra/docker-compose.yml, inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=UBOS <no-reply@ubos.local>

# "Continue with Google / Microsoft" — free; see docs/LOGIN_SETUP.md. Leave empty to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Integration credentials (CallerDesk, WhatsApp, Razorpay, Google Sheets, AI providers) are entered per
# organization in the Integrations Hub and stored encrypted in the database — not here.
