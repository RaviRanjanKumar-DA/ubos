# Copy to .env (gitignored). Values below match infra/docker-compose.yml for local development.

# Owner role: migrations and seed only.
DATABASE_URL=postgresql://ubos:ubos@localhost:5432/ubos
# Runtime role subject to row-level security (tenant API).
APP_DATABASE_URL=postgresql://ubos_app:ubos_app_dev@localhost:5432/ubos
# Runtime role that bypasses RLS (Platform Console API only).
PLATFORM_DATABASE_URL=postgresql://ubos_platform:ubos_platform_dev@localhost:5432/ubos

# Generate long random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_PLATFORM_SECRET=

API_PORT=4000
WEB_ORIGIN=http://localhost:3030
# Web app → API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Integration credentials (CallerDesk, WhatsApp, Razorpay, Google Sheets, AI providers) are entered per
# organization in the Integrations Hub and stored encrypted in the database — not here.
