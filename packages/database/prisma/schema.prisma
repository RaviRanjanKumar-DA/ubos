// UBOS — DRAFT data model v2 (multi-tenant SaaS), for review with the blueprint.
// Hierarchy: Platform → Tenant (organization) → Workspaces (business lines) → Pipelines.
// Every tenant-owned table carries tenantId; PostgreSQL row-level security enforces isolation.
// Provider can be switched to "mysql" or "sqlserver" for dedicated enterprise deployments
// (RLS policies then fall back to application-level enforcement).
// Money is stored in paise (Int/BigInt). All timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════ PLATFORM (SaaS) ═════════════════════════

model Plan {
  id               String         @id @default(uuid())
  code             String         @unique // starter | growth | business | enterprise
  name             String
  pricePerUserPaise Int
  billingPeriods   String[]       // ["monthly","annual"]
  maxWorkspaces    Int?           // null = unlimited
  storageGbPerUser Int
  aiCreditsPerUser Int            @default(0)
  recordingRetentionDays Int      @default(90) // how long call recordings are kept on this plan (0 = none)
  isPublic         Boolean        @default(true)
  features         PlanFeature[]
  subscriptions    Subscription[]
}

model PlanFeature {
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id])
  featureKey String // e.g. "module.hrms", "module.telephony", "integration.callerdesk"

  @@id([planId, featureKey])
}

model Tenant {
  id            String          @id @default(uuid())
  name          String          // organization name
  slug          String          @unique // acme → acme.ubos.app
  status        String          @default("trial") // trial | active | grace | suspended | cancelled
  industry      String?
  gstin         String?
  timezone      String          @default("Asia/Kolkata")
  currency      String          @default("INR")
  isInternal    Boolean         @default(false) // true for Tenant #1 (your own company)
  deployment    String          @default("shared") // shared | dedicated | onprem
  dbConnectionRef String?       // for dedicated databases
  createdAt     DateTime        @default(now())
  signedUpVia   String          @default("console") // console | self_serve | seed
  billingName   String?         // who UBOS invoices are made out to
  billingAddress String?
  billingStateCode String?
  statusChangedAt DateTime?
  domains       TenantDomain[]
  subscriptions Subscription[]
  overrides     TenantEntitlement[]
  workspaces    Workspace[]
  branches      Branch[]
  users         User[]
}

model TenantDomain {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  host       String  @unique // custom domain, e.g. crm.acme.com
  verified   Boolean @default(false)
}

model TenantEntitlement {
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  featureKey String
  enabled    Boolean // per-tenant override on top of the plan

  @@id([tenantId, featureKey])
}

model Subscription {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  period           String    // monthly | annual
  licences         Int
  status           String    // trialing | active | past_due | cancelled
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime
  gatewayRef       String?   // Razorpay subscription id
  invoices         PlatformInvoice[]
}

/** UBOS's GST tax invoice to a customer organization, one per paid order. */
model PlatformInvoice {
  id             String        @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  tenantId       String
  orderId        String        @unique
  number         String        @unique // UB/26-27/0001
  fy             String
  seller         Json          // UBOS legal name, GSTIN, state, address
  buyer          Json          // the organization's billing name, GSTIN, state, address
  items          Json          // the order lines
  placeOfSupply  String?
  amountPaise    Int           // before GST
  taxablePaise   Int
  cgstPaise      Int           @default(0)
  sgstPaise      Int           @default(0)
  igstPaise      Int           @default(0)
  gstPaise       Int
  totalPaise     Int
  status         String        // draft | issued | paid | overdue | void
  paymentRef     String?
  issuedAt       DateTime
  paidAt         DateTime?

  @@index([tenantId])
}

model UsageRecord {
  id        BigInt   @id @default(autoincrement())
  tenantId  String
  metric    String   // active_users | storage_gb | ai_credits | api_calls | whatsapp_msgs | call_minutes
  quantity  Decimal
  periodDay DateTime // noon IST of the day

  @@unique([tenantId, metric, periodDay])
  @@index([tenantId, metric, periodDay])
}

model PlatformUser {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  totpSecret   String? // encrypted TOTP secret
  totpEnabled  Boolean   @default(false)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  role         String  // owner | admin | sales | support | finance | tech
  isActive     Boolean @default(true)
}

// Login sessions for tenant users and platform staff. The refresh token is stored only as a SHA-256 hash.
model Session {
  id             String    @id @default(uuid())
  tenantId       String?   // null for platform staff sessions
  userId         String?
  platformUserId String?
  refreshHash    String    @unique
  prevRefreshHash String?  // previous token; presenting it again means the token was stolen
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  @@index([userId])
  @@index([platformUserId])
  @@index([prevRefreshHash])
}

// Security policy per organization (Workspace settings → Preferences / Security).
model OrganizationSetting {
  tenantId           String   @id
  sessionIdleMinutes Int      @default(480)
  ipAllowlist        String[] @default([])
  require2faRoles    String[] @default([]) // role names that must use two-factor auth
  loginMethods       String[] @default(["password", "google", "microsoft", "email_code"])
  allowedEmailDomains String[] @default([]) // empty = any domain (for Google / Microsoft / email-code login)
  leadIdentifier     String   @default("mobile") // Lead ID: the unique key that identifies a customer — mobile | email
  maxFailedLogins    Int      @default(5)
  lockMinutes        Int      @default(15)
  setupSkipped       String[] @default([]) // Setup Guide steps the admins chose to skip
  digestHour         Int      @default(9)  // local hour of the daily summary email
  reminderMinutes    Int      @default(15) // remind this many minutes before a task / follow-up
  recordingMode      String   @default("ubos") // cloud-call recordings: ubos (copied to UBOS storage) | provider (link only)
  recordingRetentionDays Int?  // shorter than the plan limit if the organization wants
  unknownCallerWorkspaceId String? // calls from numbers not in UBOS become leads here (null = keep as unmatched calls)
  dispositionRequired Boolean @default(false) // the phone app asks for a call outcome after every call
  updatedAt          DateTime @updatedAt
}

model SupportAccessGrant {
  id             String   @id @default(uuid())
  tenantId       String
  platformUserId String
  grantedByUserId String  // tenant admin who consented
  readOnly       Boolean  @default(true)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

// ═════════════════════════ TENANT: organization & workspaces ═════════════════════════

// A business line inside an organization, e.g. "Course/Software", "Logo Designing", "Vastu Consultation/Audit".
model Workspace {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  template  String?    // education | real_estate | consulting | design_services | software ...
  invoiceSeries String?
  gstin     String?    // when a business line bills under a separate entity
  isArchived Boolean   @default(false)
  // Who gets new leads from forms, integrations and imports (manual entries stay with their creator).
  assignmentMode    String   @default("round_robin") // round_robin | creator | fixed
  assignmentUserIds String[] @default([])            // round-robin pool / fixed owner (first id)
  assignmentCursor  Int      @default(0)
  stickyOwner       Boolean  @default(true)          // a returning customer goes back to their RM
  displayH1         String   @default("name")        // what lists and headers show as the title of a lead
  displayH2         String   @default("mobile")      // …and as the second line (name / mobile / email / city / cf:<key>)
  valueFieldKey     String?  // a number / amount lead field holding the deal value (for pipeline value and forecasts)
  quoteMaxDiscountPct Int    @default(10)              // a quote with more discount than this needs approval
  quoteTerms        String?  // default terms printed on quotes
  pipelines Pipeline[]
  leads     Lead[]
  packages  Package[]
  fields    LeadField[]
  options   WorkspaceOption[]

  @@unique([tenantId, slug])
}

// Custom lead field of one workspace (business line). Values live in Lead.customFields under `key`.
model LeadField {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  key         String    // stable machine name, e.g. "property_type"; never changes after creation
  label       String
  type        String    // text | textarea | number | currency | date | dropdown | multiselect | checkbox | phone | email | url
  options     String[]  @default([])
  required    Boolean   @default(false)
  position    Int       @default(0)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([workspaceId, key])
}

// Simple pick-lists per workspace: lead sources and lost reasons (later: call feedback, tags…).
model WorkspaceOption {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  kind        String    // lead_source | lost_reason | lead_status | call_disposition
  value       String    // stored on records (lead.source / lead.lostReason / lead.status / activity.disposition)
  label       String
  position    Int       @default(0)
  isArchived  Boolean   @default(false)
  connected   Boolean   @default(false) // call_disposition only: the customer was actually reached
  isDefault   Boolean   @default(false) // call_disposition: used when a call connects; lead_status: given to new leads

  @@unique([workspaceId, kind, value])
}

// A process inside a workspace, e.g. Education → Admissions / Renewals; Vastu → Consultation / Site Audit.
model Pipeline {
  id          String      @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  name        String
  position    Int         @default(0)
  stages      LeadStage[]
  leads       Lead[]
}

model LeadStage {
  id         String   @id @default(uuid())
  tenantId   String
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  position   Int
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  color      String?             // hex colour on the stage board
  slaDays    Int?                // warn when a lead stays longer than this in the stage
  requiredFieldKeys String[] @default([]) // custom fields that must be filled before entering this stage
  setStatus  String?             // lead status applied automatically on entering the stage
  followUpDays Int?              // follow-up created automatically N days after entering the stage
  winProbability Int?            // % chance an open lead in this stage is won (forecast); null = default by position
}

// Routes a source (form, WhatsApp number, CallerDesk number, webhook, sheet) to a workspace + pipeline.
model LeadSourceMapping {
  id          String @id @default(uuid())
  tenantId    String
  sourceType  String // facebook_form | whatsapp_number | callerdesk_number | webhook | google_sheet | website_form
  sourceRef   String // form id / phone number / endpoint key / sheet id
  workspaceId String
  pipelineId  String

  @@unique([tenantId, sourceType, sourceRef])
}

model Branch {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  departments Department[]
}

model Department {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  name     String
  teams    Team[]
  employees Employee[]
}

model Team {
  id           String     @id @default(uuid())
  tenantId     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  workspaceId  String?    // sales teams usually belong to one business line
  name         String
  members      User[]
}

model User {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  teamId        String?
  team          Team?      @relation(fields: [teamId], references: [id])
  reportsToId   String?
  reportsTo     User?      @relation("Hierarchy", fields: [reportsToId], references: [id])
  directReports User[]     @relation("Hierarchy")
  name          String
  email         String
  username      String?
  mobile        String?
  passwordHash  String
  totpSecret    String?    // encrypted
  totpEnabled   Boolean    @default(false)
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  passwordChangedAt DateTime?
  mustChangePassword Boolean @default(false)
  isActive      Boolean    @default(true)
  digestEnabled Boolean    @default(true)   // daily summary email
  acceptingLeads Boolean   @default(true)   // off = skipped by automatic assignment (manual transfer still possible)
  lastDigestAt  DateTime?
  roles         UserRole[]
  employee      Employee?
  createdAt     DateTime   @default(now())

  @@unique([tenantId, email])
  @@unique([tenantId, username])
}

// One-time login codes sent by email ("Sign in with email code"). Only a hash of the code is stored.
model LoginCode {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
}

// ═════════════════════════ Roles & permissions (multi-role, per workspace) ═════════════════════════

enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  BRANCH
  WORKSPACE
  ORGANIZATION
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String           // any custom name, e.g. "Content Creator"
  isTemplate  Boolean          @default(false)
  permissions RolePermission[]
  fieldRules  FieldRule[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique // e.g. "crm.lead.export"
  roles RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id])
  scope         DataScope  @default(OWN)
  isDeny        Boolean    @default(false)
  maxExportRows Int?

  @@id([roleId, permissionId])
}

model FieldRule {
  id         String @id @default(uuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id])
  entity     String // e.g. "customer"
  field      String // e.g. "mobile"
  visibility String // hidden | masked | visible | editable
}

// A user can hold many roles; each assignment is for one workspace or the whole organization (workspaceId = null).
model UserRole {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  workspaceId  String?
  branchId     String?
  departmentId String?
  validFrom    DateTime?
  validTo      DateTime?
  isPrimary    Boolean   @default(false) // decides default dashboard

  @@unique([userId, roleId, workspaceId, branchId, departmentId])
}

// ═════════════════════════ CRM ═════════════════════════

// Shared across all workspaces of the organization.
model Customer {
  id           String            @id @default(uuid())
  tenantId     String
  code         String            // human-readable Customer ID
  name         String
  mobile       String?           // E.164; unique per organization among active (unmerged) customers
  alternateMobiles String[]      @default([])
  email        String?
  alternateEmails String[]       @default([])
  whatsappOptOut  Boolean        @default(false) // replied STOP: no templates or broadcasts any more
  smsOptOut       Boolean        @default(false)
  emailOptOut     Boolean        @default(false) // used the unsubscribe link
  city         String?
  gstin          String?
  billingAddress String?
  stateCode      String?
  panEncrypted String?
  panLast4     String?
  panHash      String?           // keyed hash, lets us find the same PAN without decrypting
  aadhaarLast4 String?           // full number never stored by default
  primaryRmId  String?
  customFields Json?
  mergedIntoId String?           // set when this record was merged into another customer
  mergedAt     DateTime?
  leads        Lead[]
  packages     CustomerPackage[]
  accessGrants CustomerAccess[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  tickets      Ticket[]

  @@unique([tenantId, code])
  @@index([tenantId, mobile])
  @@index([tenantId, email])
  @@index([tenantId, panHash])
}

// History of customer merges; keeps what is needed to undo a merge.
model CustomerMerge {
  id              String    @id @default(uuid())
  tenantId        String
  primaryId       String
  duplicateId     String
  movedLeadIds    String[]
  movedPackageIds String[]
  movedAccessIds  String[] @default([])
  filledFields    Json      // fields copied from the duplicate onto the primary (reverted on undo)
  reason          String?
  mergedById      String
  createdAt       DateTime  @default(now())
  undoneAt        DateTime?
  undoneById      String?

  @@index([tenantId, primaryId])
  @@index([tenantId, duplicateId])
}

// "These two are different people" — hides the pair from duplicate suggestions.
model CustomerDuplicateDismissal {
  id            String   @id @default(uuid())
  tenantId      String
  customerAId   String   // the smaller id of the pair
  customerBId   String
  dismissedById String
  createdAt     DateTime @default(now())

  @@unique([tenantId, customerAId, customerBId])
}

model Lead {
  id              String     @id @default(uuid())
  tenantId        String
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  pipelineId      String
  pipeline        Pipeline   @relation(fields: [pipelineId], references: [id])
  stageId         String
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  source          String     // website, facebook, whatsapp, google_sheets, referral, api, manual, cross_sell...
  referredFromLeadId String? // cross-sell from another workspace
  ownerId         String?
  assignedAt      DateTime?
  status          String?    // lead status value (Hot / Warm / Cold …) from the workspace list; separate from stage
  rating          Int?
  customFields    Json?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  firstResponseAt DateTime?
  lastActivityAt  DateTime?
  lastDisposition String?
  nextFollowUpAt  DateTime?  // earliest open follow-up, kept in sync for fast "due today" lists
  stageChangedAt  DateTime   @default(now()) // for stage SLA ("in this stage for 4 days")
  score           Int        @default(0)     // lead score, e.g. from custom-action scores
  labelIds        String[]   @default([])    // Label ids
  teamMembers     LeadTeamMember[]
  importId        String?
  followUps       FollowUp[]
  activities      LeadActivity[]
  campaignItems   CallCampaignItem[]

  @@index([tenantId, workspaceId, pipelineId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, nextFollowUpAt])
  invoices        Invoice[]
}

model FollowUp {
  id          String    @id @default(uuid())
  tenantId    String
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  dueAt       DateTime
  note        String?
  doneAt      DateTime?
  outcome     String?
  userId      String
  createdById String?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId, doneAt, dueAt])
  @@index([leadId])
}

// Everything that happens on a lead: calls (with disposition), remarks, status changes, assignments, imports.
model LeadActivity {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  type        String    // call | remark | status | assignment | stage | follow_up | import
  disposition String?   // call: workspace call_disposition value
  connected   Boolean?  // call: reached the customer
  durationSec Int?
  remark      String?
  data        Json?     // extra details (old/new values etc.)
  userId      String?
  createdAt   DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
}

// One bulk upload (CSV / Excel) with its outcome.
model LeadImport {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  fileName    String
  total       Int
  created     Int
  linked      Int      // rows that matched an existing customer
  skipped     Int      // duplicates in this business line that were skipped
  failed      Int
  errors      Json     // [{ row, message }]
  createdById String
  createdAt   DateTime @default(now())

  @@index([tenantId, workspaceId, createdAt])
}

// Products, services and packages sold by a business line.
model Package {
  id          String            @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  name        String            // Elite, BSP, NME, VPM, Logo Basic, Vastu Audit...
  code        String?           // SKU / short code
  description String?
  category    String?
  unit        String            @default("unit")
  mrpPaise    Int
  gstRate     Decimal
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  sales       CustomerPackage[]
  accessGrants CustomerAccess[]
  accessKind      String  @default("none") // none | course | software | service
  validityDays    Int?
  renewBeforeDays Int     @default(30)
  remindCustomer  Boolean @default(false)
  showInGallery   Boolean @default(false)
  offerPaise      Int?
  photoKey        String?
  photoType       String?
  brochureUrl     String?
  priceItems  PriceListItem[]
}

// A price list of a business line (e.g. "Standard", "Festive offer"); prices fall back to the product MRP.
model PriceList {
  id          String          @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  isDefault   Boolean         @default(false)
  validFrom   DateTime?
  validTo     DateTime?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  items       PriceListItem[]

  @@index([tenantId, workspaceId])
}

model PriceListItem {
  id            String    @id @default(uuid())
  tenantId      String
  priceListId   String
  priceList     PriceList @relation(fields: [priceListId], references: [id])
  packageId     String
  package       Package   @relation(fields: [packageId], references: [id])
  pricePaise    Int
  minPricePaise Int?      // lowest price a rep may offer without approval

  @@unique([priceListId, packageId])
}

// Quote / proposal made from a lead.
model Quote {
  id            String      @id @default(uuid())
  tenantId      String
  workspaceId   String
  leadId        String
  customerId    String
  number        String      // Q-2026-0001
  status        String      @default("draft") // draft | pending_approval | approved | sent | accepted | rejected
  priceListId   String?
  validUntil    DateTime?
  subtotalPaise Int         @default(0) // list value before discount
  discountPaise Int         @default(0)
  taxPaise      Int         @default(0)
  totalPaise    Int         @default(0)
  notes         String?
  terms         String?
  needsApproval Boolean     @default(false)
  approvalId    String?
  createdById   String
  sentAt        DateTime?
  decidedAt     DateTime?   // accepted / rejected by the customer
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  items         QuoteItem[]

  @@unique([tenantId, number])
  @@index([tenantId, leadId])
}

model QuoteItem {
  id             String  @id @default(uuid())
  tenantId       String
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id])
  packageId      String?
  name           String
  qty            Int     @default(1)
  listPricePaise Int     // price-list / MRP unit price
  pricePaise     Int     // offered unit price
  gstRate        Float   @default(0)
  position       Int     @default(0)
}

// Anything waiting for a manager's yes / no: quote discounts, process steps that need sign-off.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  workspaceId   String
  leadId        String?
  kind          String    // quote_discount | process_step
  entityId      String    // quote id / step-run id
  title         String
  details       Json?
  status        String    @default("pending") // pending | approved | rejected | cancelled
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
  @@index([tenantId, entityId])
}

// What happens after a sale: ordered steps with owners, forms, payment gates and approvals (per business line).
model ProcessTemplate {
  id          String        @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  description String?
  trigger     String        @default("won") // won (starts when a lead is won) | manual
  packageIds  String[]      @default([])    // only for these products (empty = any sale)
  isArchived  Boolean       @default(false)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  steps       ProcessStep[]

  @@index([tenantId, workspaceId])
}

model ProcessStep {
  id               String          @id @default(uuid())
  tenantId         String
  templateId       String
  template         ProcessTemplate @relation(fields: [templateId], references: [id])
  position         Int
  name             String
  instructions     String?
  assignTo         String          @default("lead_owner") // lead_owner | user | role
  assigneeUserId   String?
  ownerRoleId      String?         // responsible role (assignTo = role: first available person with it)
  dueDays          Int?            // due this many days after the step starts
  fields           Json            @default("[]") // [{ key, label, type, options, required }]
  minPaymentPct    Int?            // step can only be completed once this % of the deal value is received
  requiresApproval Boolean         @default(false)
  access           Json            @default("{}") // roleId → edit | view | none (roles not listed: view)
  isArchived       Boolean         @default(false)
}

// One customer's journey through a process template.
model ProcessRun {
  id              String    @id @default(uuid())
  tenantId        String
  workspaceId     String
  templateId      String
  leadId          String
  customerId      String
  quoteId         String?
  status          String    @default("active") // active | completed | cancelled
  dealValuePaise  Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  cancelledReason String?
  rating          Int?      // customer rating 1-5 recorded at completion
  ratingNote      String?
  createdById     String
  steps           StepRun[]

  @@index([tenantId, leadId])
  @@index([tenantId, workspaceId, status])
}

model StepRun {
  id            String     @id @default(uuid())
  tenantId      String
  runId         String
  run           ProcessRun @relation(fields: [runId], references: [id])
  stepId        String
  position      Int
  status        String     @default("pending") // pending | active | awaiting_approval | done
  assigneeId    String?
  dueAt         DateTime?
  data          Json       @default("{}")
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  locked        Boolean    @default(false) // done steps are locked; unlocking needs process.unlock and a reason
  approvalId    String?
  sentBackCount Int        @default(0)
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([runId])
  @@index([tenantId, assigneeId, status])
}

// Money received from a customer: token, instalments, balance. Never deleted — a wrong entry is voided.
model Payment {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  customerId  String
  leadId      String?
  runId       String?
  packageId   String?
  amountPaise Int
  kind        String    @default("instalment") // token | instalment | balance | full
  mode        String    @default("upi")        // cash | upi | card | bank | cheque | online
  reference   String?
  receivedAt  DateTime  @default(now())
  note        String?
  source      String    @default("manual")     // manual | rule (payment rules) | gateway (1.7) | invoice
  invoiceId   String?
  receiptNumber String?
  isVoided    Boolean   @default(false)
  voidReason  String?
  voidedById  String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, runId])
  @@index([tenantId, customerId])
}

// Decides what an incoming payment is: a new sale (opens a won lead + process) or an instalment of a running one.
model PaymentRule {
  id             String   @id @default(uuid())
  tenantId       String
  workspaceId    String
  name           String
  position       Int      @default(0)
  minAmountPaise Int?
  maxAmountPaise Int?
  packageIds     String[] @default([])
  action         String   // new_sale | instalment
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([tenantId, workspaceId])
}

// Extra people working on a lead (designer, consultant, accounts) with a role label; they can see the lead.
model LeadTeamMember {
  id        String    @id @default(uuid())
  tenantId  String
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  userId    String
  roleLabel String
  addedById String
  createdAt DateTime  @default(now())
  removedAt DateTime?

  @@index([tenantId, userId])
  @@index([leadId])
}

// Temporary cover while someone is away: their new leads go to the cover person, who also sees their leads.
model UserCover {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  coverUserId String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  createdById String
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, coverUserId])
}

model CustomerPackage {
  id                String   @id @default(uuid())
  tenantId          String
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  packageId         String
  package           Package  @relation(fields: [packageId], references: [id])
  mrpPaise          Int
  offerPricePaise   Int
  discountPaise     Int
  secondaryRmId     String?
  secondarySplitPct Int?
  collectionStatus  String   @default("pending") // pending | partial | paid | refunded
  soldAt            DateTime @default(now())
}

// ═════════════════════════ Integrations (per tenant) ═════════════════════════

model IntegrationConnection {
  id              String    @id @default(uuid())
  tenantId        String
  workspaceId     String?   // e.g. a WhatsApp number dedicated to one business line
  key             String    // callerdesk, whatsapp, google_sheets, razorpay...
  status          String    @default("inactive") // active | paused | inactive
  configEncrypted String?   // encrypted with the tenant's data key
  activatedById   String?
  activatedAt     DateTime?
  lastEventAt     DateTime?

  @@index([tenantId, key])
}

// Every incoming webhook / form / API / sheet record, kept so it can be inspected and replayed.
model WebhookInbox {
  id             String    @id @default(uuid())
  tenantId       String?
  integrationKey String    // website_api, indiamart, form:<slug>, api, google_sheets …
  headers        Json
  body           String
  status         String    @default("received") // received | processed | failed | duplicate | skipped
  attempts       Int       @default(0)
  receivedAt     DateTime  @default(now())
  externalId     String?   // sender's id (portal enquiry id, sheet row hash, Idempotency-Key) — the same one is never processed twice
  outcome        String?   // created | linked | add_remark | update_blank | overwrite | skip | rejected
  leadId         String?
  error          String?
  processedAt    DateTime?

  @@index([tenantId, integrationKey, receivedAt])
  @@index([tenantId, integrationKey, externalId])
}

// Organization API keys for the public API. Only a hash of the key is stored; it is shown once.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  prefix      String    // first characters, shown in lists
  keyHash     String    @unique
  scopes      String[]  // leads:read, leads:write, customers:read, meta:read
  workspaceId String?   // limited to one business line (null = all)
  createdById String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// Outgoing webhooks: UBOS calls another system when something happens (signed with HMAC).
model WebhookSubscription {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  url             String
  events          String[]
  workspaceId     String?
  secretEncrypted String
  isActive        Boolean   @default(true)
  createdById     String
  failureCount    Int       @default(0) // consecutive failures; paused after too many
  lastDeliveryAt  DateTime?
  lastStatus      Int?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  tenantId       String
  subscriptionId String
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  responseStatus Int?
  responseBody   String?
  error          String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([tenantId, subscriptionId, createdAt])
}

// Web-to-lead form of a business line: hosted page + embed code.
model LeadForm {
  id            String   @id @default(uuid())
  tenantId      String
  workspaceId   String
  name          String
  slug          String
  title         String
  description   String?
  fields        Json     // [{ target: name | mobile | email | city | remark | cf:<key>, label, required, placeholder }]
  submitLabel   String   @default("Submit")
  thankYou      String   @default("Thank you! We will contact you soon.")
  redirectUrl   String?
  source        String   @default("website")
  duplicateMode String   @default("add_remark")
  color         String   @default("#5b3cc4")
  isActive      Boolean  @default(true)
  isArchived    Boolean  @default(false)
  submissions   Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([tenantId, slug])
}

// ═════════════════════════ HRMS & Assets (organization level) ═════════════════════════

model Employee {
  id             String             @id @default(uuid())
  tenantId       String
  userId         String?            @unique // optional UBOS login
  user           User?              @relation(fields: [userId], references: [id])
  employeeCode   String
  name           String             @default("")
  mobile         String?
  workEmail      String?
  designation    String?
  departmentId   String?
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType String             @default("full_time") // full_time | part_time | contract | intern
  workLocation   String?
  joiningDate    DateTime
  probationEnd   DateTime?
  exitDate       DateTime?
  exitReason     String?
  status         String             @default("onboarding") // onboarding | active | notice | exited
  dateOfBirth    DateTime?
  personalEmail  String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  panEncrypted   String?
  panLast4       String?
  bankEncrypted  String?            // account number and IFSC, encrypted together
  bankLast4      String?
  ctcPaise       Int?
  noticeDays     Int                @default(30)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  leaveRequests  LeaveRequest[]
  assets         AssetAssignment[]
  tasks          EmployeeTask[]
  documents      EmployeeDocument[]
  attendance     Attendance[]
  attendanceRequests AttendanceRequest[]
  leaveAdjustments LeaveAdjustment[]

  @@unique([tenantId, employeeCode])
}

model LeaveRequest {
  id           String     @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  leaveType    String     @default("") // type code at the time of the request
  leaveTypeId  String?
  type         LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  fromDate     DateTime // noon IST of the first day
  toDate       DateTime
  halfDay      Boolean    @default(false)
  days         Float      @default(0)
  reason       String?
  status       String     @default("pending") // pending | approved | rejected | cancelled
  approverId   String?
  createdById  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime   @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model Asset {
  id          String            @id @default(uuid())
  tenantId    String
  tag         String
  name        String            @default("")
  category    String            // laptop, mobile, sim, headset...
  serialNo    String?
  costPaise   Int?
  purchasedAt DateTime?
  warrantyEnd DateTime?
  condition   String            @default("good")
  status      String            @default("available") // available | assigned | repair | retired
  notes       String?
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  assignments AssetAssignment[]

  @@unique([tenantId, tag])
}

model AssetAssignment {
  id              String    @id @default(uuid())
  tenantId        String
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  issuedAt        DateTime  @default(now())
  acknowledgedAt  DateTime?
  returnedAt      DateTime?
  returnCondition String?
}

// ═════════════════════════ Audit (append-only) ═════════════════════════

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  // null for platform-level events
  workspaceId String?
  actorType   String   // tenant_user | platform_user | system | api_key
  actorId     String?
  ip          String?
  entity      String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  reason      String?
  prevHash    String?
  hash        String
  createdAt   DateTime @default(now())

  @@index([tenantId, entity, entityId])
}

// Custom action: a small form run from a lead (e.g. "Course Details"); answers go on the timeline and add to the lead score.
model CustomAction {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String?   // null = available in every workspace
  code        Int       // human-friendly code (1001, 1002…)
  name        String
  description String?
  score       Int       @default(0)
  fields      Json      // [{ key, label, type, options, required }] — same types as custom lead fields
  isArchived  Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([tenantId, code])
}

model LeadActionResponse {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  leadId      String
  actionId    String
  answers     Json
  score       Int
  userId      String
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([actionId])
}

// What the platform sells: licences (per user) and one-time services. Managed by the Platform Owner.
model PlatformProduct {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  kind              String   // licence | service
  planCode          String?  // licence: the plan it activates
  priceMonthlyPaise Int?     // licence: per user per month
  priceOncePaise    Int?     // service: one-time price
  annualDiscountPct Int      @default(0)
  isActive          Boolean  @default(true)
  position          Int      @default(0)
}

// ── Slice 1.5c: productivity & views ──

/** Coloured label (tag) for leads; per business line or organization-wide (workspaceId = null). */
model Label {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  color       String   @default("#5b3cc4")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, workspaceId])
}

/** Smart view: saved lead filters, columns and layout; personal or shared with roles. */
model SavedView {
  id            String   @id @default(uuid())
  tenantId      String
  ownerId       String
  workspaceId   String?
  name          String
  query         Json     // filters + sort as on the leads page
  columns       String[] @default([])
  layout        String   @default("list") // list | board
  sharedRoleIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, ownerId])
}

/** Task, meeting or planned call — on a lead or on its own. */
model Task {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String?
  leadId      String?
  type        String    @default("task") // task | meeting | call
  title       String
  notes       String?
  dueAt       DateTime
  durationMin Int?
  location    String?   // address or meeting link
  assigneeId  String
  createdById String
  mentionIds  String[]  @default([])
  doneAt      DateTime?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, assigneeId, doneAt, dueAt])
  @@index([leadId])
}

/** In-app notification (mentions, reminders, assignments). */
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String    // mention | reminder | assignment | digest
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
}

/** Target for a metric per period, for a person, a team or the whole business line / organization. */
model Goal {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  metric      String   // analytics metric key, e.g. won, calls, won_value
  period      String   @default("month") // week | month | quarter
  target      Int      // in the metric's unit (paise for amounts)
  userId      String?
  teamId      String?
  createdById String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
}

/** Call script shown in the Log-call panel, for a stage or the whole business line. */
model CallScript {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  stageId     String?
  title       String
  body        String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

/** "Email me this dashboard": each person subscribes for themselves, so numbers follow their own access. */
model DashboardSubscription {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  dashboardId String    // a saved dashboard id or "tpl:<key>"
  frequency   String    @default("daily") // daily | weekly (Mondays)
  hour        Int       @default(9)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, dashboardId])
}

// A saved dashboard: widgets with their metric, chart and size. Personal, or shared with roles / teams / business lines / people.
model Dashboard {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  ownerId            String
  widgets            Json     // WidgetConfig[] (see @ubos/shared analytics)
  range              String   @default("this_month")
  sharedRoleIds      String[] @default([])
  sharedTeamIds      String[] @default([])
  sharedWorkspaceIds String[] @default([])
  sharedUserIds      String[] @default([])
  defaultForRoleIds  String[] @default([]) // landing dashboard for these roles
  isLocked           Boolean  @default(false) // only the owner / dashboard managers may change it
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, ownerId])
}

// An organization's purchase: licences for a billing cycle and/or services. Paid via gateway later; marked paid manually for now.
model TenantOrder {
  id            String    @id @default(uuid())
  tenantId      String
  number        String    @unique
  cycle         String    // quarterly | annual | one_time
  items         Json      // [{ productCode, name, kind, quantity, unitPaise, amountPaise }]
  subtotalPaise Int
  gstPaise      Int
  totalPaise    Int
  status        String    @default("pending") // pending | paid | cancelled
  createdById   String
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  paymentRef    String?
  note          String?
  paymentLinkId String?   @unique // Razorpay payment link on the UBOS account
  paymentLinkUrl String?
  paymentLinkExpiresAt DateTime?
  paidVia       String?   // manual | online
  invoiceId     String?

  @@index([tenantId, createdAt])
}

// ═════════════════════════ Calling (Phase 2) ═════════════════════════

// Every call, whatever the channel (SIM phone app, cloud provider, logged by hand). The same externalId is stored once.
model Call {
  id               String    @id @default(uuid())
  tenantId         String
  externalId       String    // deviceId:callLogId:startTime (SIM) / provider call id (cloud) / activity id (manual)
  channel          String    // sim | cloud | manual
  provider         String?   // callerdesk …
  direction        String    // outbound | inbound
  phone            String    // the other party (E.164 when it could be read)
  userId           String?
  deviceId         String?
  workspaceId      String?
  leadId           String?   // null = unmatched (number not in UBOS yet)
  customerId       String?
  activityId       String?   // the call on the lead's journey
  startedAt        DateTime
  ringSec          Int       @default(0)
  talkSec          Int       @default(0)
  answered         Boolean   @default(false)
  disposition      String?
  remark           String?
  recordingStatus  String    @default("none") // none | uploading | ready | link | deleted
  recordingKey     String?   // storage key (encrypted file)
  recordingLinkEnc String?   // provider recording URL, encrypted (recording mode "link only")
  recordingBytes   Int?
  recordingMime    String?
  recordingTotal   Int?      // expected size while uploading
  clientUpdatedAt  DateTime? // edit time on the phone (latest edit wins)
  receivedAt       DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  campaignId       String?   // set when the call was made from a calling campaign

  @@unique([tenantId, externalId])
  @@index([tenantId, campaignId])
  @@index([tenantId, startedAt])
  @@index([tenantId, leadId])
  @@index([tenantId, userId, startedAt])
}

// A paired phone (SIM-calling app). Only a hash of its token is stored.
model Device {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  name         String
  platform     String    @default("android")
  appVersion   String?
  tokenHash    String    @unique
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?
  pendingCalls Int       @default(0) // reported by the app: calls waiting to sync
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId])
}

model PairingCode {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, codeHash])
}

// "Call" pressed on the web: the paired phone picks it up and dials.
model DialRequest {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  leadId    String
  phone     String
  status    String    @default("pending") // pending | picked | expired
  createdAt DateTime  @default(now())
  pickedAt  DateTime?

  @@index([tenantId, userId, status])
}

// ═════════════════════════ WhatsApp (Phase 2.3) ═════════════════════════

// One chat with one WhatsApp number (the customer's), on the organization's business number.
model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  channel       String    @default("whatsapp")
  waId          String    // customer's number as WhatsApp sends it (digits, with country code)
  workspaceId   String?
  customerId    String?
  leadId        String?
  assigneeId    String?
  status        String    @default("open") // open | closed
  lastMessageAt DateTime  @default(now())
  lastInboundAt DateTime? // free replies are allowed for 24 hours after this
  unread        Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([tenantId, channel, waId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, leadId])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  direction      String   // in | out
  type           String   @default("text") // text | template | image | document | audio | other
  body           String?
  templateName   String?
  waMessageId    String?  // WhatsApp's id (same id never stored twice)
  status         String   @default("received") // received | queued | sent | delivered | read | failed
  error          String?
  userId         String?
  broadcastId    String?
  options        String[] @default([]) // buttons shown with a chatbot message
  subject        String?  // email only
  trackToken     String?  @unique // email open and click tracking
  openedAt       DateTime?
  openCount      Int      @default(0)
  clickedAt      DateTime?
  clickCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([tenantId, waMessageId])
  @@index([conversationId, createdAt])
}

// Approved WhatsApp message templates ({{1}}, {{2}} … placeholders filled from lead fields when sending).
model MessageTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  channel     String   @default("whatsapp")
  name        String   // as approved in WhatsApp Manager
  language    String   @default("en")
  category    String   @default("marketing") // marketing | utility
  body        String
  variables   String[] @default([]) // what fills {{1}}, {{2}}… (SMS: each {#var#} in order): name | mobile | city | owner | cf:<key> | text:<fixed>
  subject     String?  // email
  dltTemplateId String? // SMS: the ID registered on the DLT portal
  providerTemplateId String? // SMS: the gateway's own template ID (MSG91)
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, channel, name, language])
}

model Broadcast {
  id          String   @id @default(uuid())
  tenantId    String
  templateId  String
  name        String
  total       Int      @default(0)
  sent        Int      @default(0)
  skipped     Int      @default(0) // opted out / no number
  failed      Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
}

// ═════════════════════════ Automation (Phase 2.5) ═════════════════════════

// "When X, if Y, then Z" for one business line.
model AutomationRule {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  trigger     String    // lead.created, lead.won, lead.idle …
  idleDays    Int?      // lead.idle only
  conditions  Json      @default("[]") // [{ field, op, value }]
  actions     Json      // [{ type, ... }]
  isActive    Boolean   @default(true)
  isArchived  Boolean   @default(false)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([tenantId, workspaceId, trigger])
}

// Something happened that rules may react to; handled in the background.
model AutomationEvent {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String?
  event       String
  data        Json
  depth       Int       @default(0) // rules triggering rules stop after three links
  status      String    @default("pending") // pending | done
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model AutomationRun {
  id        String   @id @default(uuid())
  tenantId  String
  ruleId    String
  event     String
  leadId    String?
  status    String   // done | failed
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, ruleId, createdAt])
  @@index([ruleId, leadId, createdAt])
}

// Messages sent over time, stopped by a reply.
model Sequence {
  id          String               @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  steps       Json                 // [{ delayHours, templateId }]
  stopOnReply Boolean              @default(true)
  isArchived  Boolean              @default(false)
  createdById String
  createdAt   DateTime             @default(now())
  enrollments SequenceEnrollment[]

  @@index([tenantId, workspaceId])
}

model SequenceEnrollment {
  id          String   @id @default(uuid())
  tenantId    String
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id])
  leadId      String
  stepIndex   Int      @default(0)
  nextAt      DateTime
  status      String   @default("active") // active | completed | stopped
  stopReason  String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([status, nextAt])
  @@index([tenantId, leadId])
}

/// A calling campaign: a list of leads worked one by one by the chosen callers (power dialer).
model CallCampaign {
  id            String   @id @default(uuid())
  tenantId      String
  workspaceId   String
  name          String
  status        String   @default("active") // active | paused | completed
  agentIds      String[] @default([])
  maxAttempts   Int      @default(3)
  retryAfterMin Int      @default(60)
  filter        Json     // how the list was chosen
  isArchived    Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  items         CallCampaignItem[]

  @@index([tenantId, workspaceId])
}

/// One lead in a campaign queue. The partial unique index "one open per agent" lives in the migration.
model CallCampaignItem {
  id              String       @id @default(uuid())
  tenantId        String
  campaignId      String
  campaign        CallCampaign @relation(fields: [campaignId], references: [id])
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id])
  position        Int
  status          String       @default("pending") // pending | active | done | closed (lead won or lost)
  agentId         String?
  claimedAt       DateTime?
  lockedUntil     DateTime?    // a claimed lead that was not dialed returns to the queue after this
  dialedAt        DateTime?    // once dialed, the outcome must be saved before moving on
  attempts        Int          @default(0)
  nextAt          DateTime     @default(now())
  callId          String?
  lastDisposition String?
  connected       Boolean?
  lastAt          DateTime?

  @@unique([campaignId, leadId])
  @@index([tenantId, campaignId, status, nextAt])
}

/// Coaching comment on a call, optionally at a moment in its recording.
model CallComment {
  id         String   @id @default(uuid())
  tenantId   String
  callId     String
  authorId   String
  atSec      Int?
  body       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, callId])
}

/// A customer's support request, with first response and resolution targets.
model Ticket {
  id                 String    @id @default(uuid())
  tenantId           String
  workspaceId        String
  number             Int
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  leadId             String?
  subject            String
  description        String?
  status             String    @default("open")   // open | pending (waiting on customer, clock stopped) | resolved | closed
  priority           String    @default("normal") // low | normal | high | urgent
  category           String?
  source             String    @default("manual")
  assigneeId         String?
  createdById        String
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  firstRespondedAt   DateTime?
  pausedAt           DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  breachNotifiedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  messages           TicketMessage[]

  @@unique([tenantId, number])
  @@index([tenantId, workspaceId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, assigneeId, status])
}

model TicketMessage {
  id          String   @id @default(uuid())
  tenantId    String
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  authorId    String?
  kind        String   // reply (to the customer) | note (internal) | event (status, owner changes)
  body        String
  emailStatus String   @default("none") // none | sending | sent | failed
  createdAt   DateTime @default(now())

  @@index([tenantId, ticketId, createdAt])
}

/// Targets of a business line per priority; built-in defaults apply until saved.
model TicketSla {
  id               String @id @default(uuid())
  tenantId         String
  workspaceId      String
  priority         String
  firstResponseMin Int
  resolutionMin    Int

  @@unique([workspaceId, priority])
  @@index([tenantId])
}

model KbArticle {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  title       String
  body        String
  category    String?
  status      String   @default("draft") // draft | published
  isArchived  Boolean  @default(false)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId, workspaceId, status])
}

/** A public page where a customer books a meeting with one person. Hours are per IST weekday (0 = Sunday), in minutes from midnight. */
model BookingLink {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  hostId      String
  slug        String
  title       String
  description String?
  durationMin Int       @default(30)
  bufferMin   Int       @default(0)
  noticeHours Int       @default(4)
  horizonDays Int       @default(30)
  hours       Json
  location    String?
  isActive    Boolean   @default(true)
  isArchived  Boolean   @default(false)
  bookings    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entries     Booking[]

  @@unique([tenantId, slug])
  @@index([tenantId, workspaceId])
}

model Booking {
  id              String      @id @default(uuid())
  tenantId        String
  linkId          String
  link            BookingLink @relation(fields: [linkId], references: [id])
  hostId          String
  leadId          String?
  taskId          String?
  name            String
  mobile          String?
  email           String?
  note            String?
  startAt         DateTime
  endAt           DateTime
  status          String      @default("booked") // booked | cancelled | failed
  cancelTokenHash String
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())

  @@index([tenantId, hostId, startAt])
  @@index([tenantId, linkId, startAt])
  @@index([tenantId, cancelTokenHash])
}

/** A Facebook page connected for Lead Ads. The page token is encrypted. */
model MetaPage {
  id             String    @id @default(uuid())
  tenantId       String
  pageId         String
  name           String
  tokenEncrypted String?
  status         String    @default("pending") // pending | active | disconnected
  workspaceId    String?
  formRoutes     Json      @default("{}") // form id -> business line
  leads          Int       @default(0)
  lastLeadAt     DateTime?
  lastError      String?
  connectedById  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, pageId])
}

/** One person's connected Gmail or Outlook. Tokens are encrypted. */
model MailAccount {
  id              String    @id @default(uuid())
  tenantId        String
  userId          String
  provider        String    // google | microsoft
  email           String
  tokensEncrypted String?
  status          String    @default("active") // active | error | disconnected
  connectedAt     DateTime  @default(now())
  syncedTo        DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  stored          Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([status, lastSyncAt])
}

/** Territory and field rules: the first match picks the owner, in turn among its people. */
model RoutingRule {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  position    Int      @default(0)
  conditions  Json
  userIds     String[] @default([])
  cursor      Int      @default(0)
  hits        Int      @default(0)
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId, position])
}

model ScoreRule {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  conditions  Json
  points      Int
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

/** Rules currently counted in a lead's score. */
model LeadScoreHit {
  id        String   @id @default(uuid())
  tenantId  String
  leadId    String
  ruleId    String
  points    Int
  createdAt DateTime @default(now())

  @@unique([leadId, ruleId])
  @@index([tenantId, ruleId])
}

/** A chatbot flow: steps of messages, buttons and questions, run on WhatsApp or website chat. */
model ChatFlow {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  channel     String   @default("whatsapp") // whatsapp | webchat
  trigger     String   @default("first_message") // first_message | keyword
  keywords    String[] @default([])
  steps       Json
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  runs        Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId, channel])
}

model ChatSession {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  flowId         String
  stepId         String
  status         String   @default("active") // active | done | handoff
  retries        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, conversationId])
}

/** A template to send to one lead at a chosen time. */
model ScheduledMessage {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  leadId      String
  templateId  String
  sendAt      DateTime
  status      String    @default("pending") // pending | sending | sent | failed | cancelled
  error       String?
  createdById String
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, sendAt])
  @@index([tenantId, leadId])
}

/** A chat button for a website. */
model ChatWidget {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  publicKey   String
  greeting    String
  color       String   @default("#4a2bc2")
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, publicKey])
}

/** The seller's details on invoices, per business line. */
model BillingProfile {
  id            String   @id @default(uuid())
  tenantId      String
  workspaceId   String   @unique
  legalName     String
  gstin         String?  // empty = not registered, no GST is charged
  stateCode     String
  address       String
  email         String?
  phone         String?
  invoicePrefix String   @default("INV")
  autoRemind    Boolean  @default(false)
  terms         String?
  bankDetails   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

/** Next invoice number per prefix and financial year. */
model InvoiceSeries {
  id       String @id @default(uuid())
  tenantId String
  prefix   String
  fy       String
  next     Int    @default(1)

  @@unique([tenantId, prefix, fy])
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  workspaceId     String
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  customerId      String
  quoteId         String?
  number          String?       // set when issued
  fy              String?
  status          String        @default("draft") // draft | issued | cancelled
  issuedAt        DateTime?
  dueAt           DateTime?
  placeOfSupply   String
  seller          Json?         // frozen when issued
  customerName    String
  customerGstin   String?
  customerAddress String?
  subtotalPaise   Int           @default(0)
  discountPaise   Int           @default(0)
  taxablePaise    Int           @default(0)
  cgstPaise       Int           @default(0)
  sgstPaise       Int           @default(0)
  igstPaise       Int           @default(0)
  roundOffPaise   Int           @default(0)
  totalPaise      Int           @default(0)
  paidPaise       Int           @default(0)
  notes           String?
  terms           String?
  cancelReason    String?
  cancelledAt     DateTime?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]
  paymentLinks    PaymentLink[]
  instalments     InvoiceInstalment[]
  reminderStage   Int           @default(0)
  lastReminderAt  DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, workspaceId, status])
  @@index([tenantId, leadId])
  @@index([tenantId, quoteId])
}

model InvoiceItem {
  id            String  @id @default(uuid())
  tenantId      String
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  position      Int     @default(0)
  description   String
  hsnSac        String?
  qty           Int
  unitPaise     Int
  discountPaise Int     @default(0)
  gstBp         Int     @default(0) // 18% = 1800
  taxablePaise  Int     @default(0)
  cgstPaise     Int     @default(0)
  sgstPaise     Int     @default(0)
  igstPaise     Int     @default(0)
  totalPaise    Int     @default(0)

  @@index([tenantId, invoiceId])
}

/** A link the customer pays an invoice with (Razorpay). */
model PaymentLink {
  id          String    @id @default(uuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  provider    String    @default("razorpay")
  providerId  String
  url         String
  amountPaise Int
  status      String    @default("created") // created | paid | cancelled | expired
  expiresAt   DateTime?
  paidAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, provider, providerId])
  @@index([tenantId, invoiceId])
}

model InvoiceInstalment {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  position    Int
  dueAt       DateTime
  amountPaise Int

  @@index([tenantId, invoiceId])
}

model ExpenseCategory {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  expenses   Expense[]

  @@unique([tenantId, name])
}

/** A cost. workspaceId empty = organization-wide. A wrong entry is voided, never deleted. */
model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  workspaceId String?
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  spentAt     DateTime
  amountPaise Int
  gstPaise    Int             @default(0)
  vendor      String?
  description String
  mode        String          @default("bank")
  reference   String?
  isVoided    Boolean         @default(false)
  voidReason  String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, spentAt])
  @@index([tenantId, workspaceId, spentAt])
}

/** The public catalogue of one business line. */
model WorkspaceGallery {
  id             String   @id @default(uuid())
  tenantId       String
  workspaceId    String   @unique
  slug           String
  title          String
  intro          String?
  whatsappNumber String?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, slug])
}

/** A customer's course, software or service access. expiresAt empty = no end date. Revoked, never deleted. */
model CustomerAccess {
  id               String    @id @default(uuid())
  tenantId         String
  workspaceId      String
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  packageId        String
  package          Package   @relation(fields: [packageId], references: [id])
  leadId           String?
  startsAt         DateTime
  expiresAt        DateTime?
  status           String    @default("active") // active | revoked
  revokeReason     String?
  licenceEncrypted String?
  licenceLast4     String?
  notes            String?
  reminderStage    Int       @default(0)
  renewalLeadId    String?
  renewedAt        DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, workspaceId, expiresAt])
  @@index([tenantId, customerId])
}

model EmployeeTask {
  id         String    @id @default(uuid())
  tenantId   String
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  kind       String    // onboarding | exit
  title      String
  position   Int       @default(0)
  doneAt     DateTime?
  doneById   String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, employeeId])
}

/** Stored encrypted through common/storage. Archived, never deleted. */
model EmployeeDocument {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  docType      String
  fileName     String
  fileKey      String
  mimeType     String
  sizeBytes    Int
  expiresAt    DateTime?
  isArchived   Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([tenantId, employeeId])
}

model HrSetting {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  onboardingTasks Json
  exitTasks       Json
  docTypes        Json
  attendance      Json? // shift, weekly offs, leave year (AttendanceSettings in @ubos/shared)
  updatedAt       DateTime @default(now()) @updatedAt
}

/** Marks a reminder as sent, so daily jobs send each one once. */
model ReminderMark {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
}

model LeaveType {
  id              String            @id @default(uuid())
  tenantId        String
  code            String
  name            String
  isPaid          Boolean           @default(true)
  yearlyDays      Float             @default(0)
  accrual         String            @default("yearly") // yearly | monthly
  carryForwardMax Float             @default(0)
  allowHalfDay    Boolean           @default(true)
  allowNegative   Boolean           @default(false) // no balance limit, e.g. leave without pay
  position        Int               @default(0)
  isArchived      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  requests        LeaveRequest[]
  adjustments     LeaveAdjustment[]

  @@unique([tenantId, code])
}

/**
 * Manual credits and debits to a leave balance, by leave year.
 */
model LeaveAdjustment {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  type        LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  days        Float
  reason      String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId, employeeId])
}

model Holiday {
  id         String   @id @default(uuid())
  tenantId   String
  day        String // YYYY-MM-DD (IST)
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, day])
}

/**
 * One row per employee per IST day: first check-in, last check-out, and any HR correction.
 */
model Attendance {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  day           String // YYYY-MM-DD (IST)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  inLat         Float?
  inLng         Float?
  outLat        Float?
  outLng        Float?
  source        String    @default("web") // web | mobile | manual
  override      String? // present | half_day | absent | on_duty, set by HR
  note          String?
  correctedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([tenantId, employeeId, day])
  @@index([tenantId, day])
}

/**
 * An employee asking to correct a day's times (forgot to check in or out).
 */
model AttendanceRequest {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  day          String
  checkInAt    DateTime
  checkOutAt   DateTime
  reason       String
  status       String    @default("pending") // pending | approved | rejected | cancelled
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, status])
}

/** Platform-wide settings for self-serve signup and the trial and renewal lifecycle (one row, id "default"). */
model PlatformSetting {
  id            String   @id @default("default")
  signupEnabled Boolean  @default(true)
  trialDays     Int      @default(14)
  trialPlanCode String   @default("business")
  trialLicences Int      @default(5)
  graceDays     Int      @default(7) // after a trial or paid period ends, before the account pauses
  sellerName      String? // UBOS's own invoice details
  sellerGstin     String?
  sellerStateCode String?
  sellerAddress   String?
  sellerEmail     String?
  invoicePrefix   String   @default("UB")
  razorpayKeyId   String? // UBOS's own Razorpay account for customers paying UBOS
  razorpaySecretEnc        String?
  razorpayWebhookSecretEnc String?
  razorpayApiBase String? // test stand-in only
  updatedAt     DateTime @default(now())
}

/** 6-digit email codes for self-serve signup (only a hash is kept). */
model SignupCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}
