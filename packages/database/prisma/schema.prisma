// UBOS — DRAFT data model v2 (multi-tenant SaaS), for review with the blueprint.
// Hierarchy: Platform → Tenant (organization) → Workspaces (business lines) → Pipelines.
// Every tenant-owned table carries tenantId; PostgreSQL row-level security enforces isolation.
// Provider can be switched to "mysql" or "sqlserver" for dedicated enterprise deployments
// (RLS policies then fall back to application-level enforcement).
// Money is stored in paise (Int/BigInt). All timestamps are UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════ PLATFORM (SaaS) ═════════════════════════

model Plan {
  id               String         @id @default(uuid())
  code             String         @unique // starter | growth | business | enterprise
  name             String
  pricePerUserPaise Int
  billingPeriods   String[]       // ["monthly","annual"]
  maxWorkspaces    Int?           // null = unlimited
  storageGbPerUser Int
  aiCreditsPerUser Int            @default(0)
  recordingRetentionDays Int      @default(90) // how long call recordings are kept on this plan (0 = none)
  isPublic         Boolean        @default(true)
  features         PlanFeature[]
  subscriptions    Subscription[]
}

model PlanFeature {
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id])
  featureKey String // e.g. "module.hrms", "module.telephony", "integration.callerdesk"

  @@id([planId, featureKey])
}

model Tenant {
  id            String          @id @default(uuid())
  name          String          // organization name
  slug          String          @unique // acme → acme.ubos.app
  status        String          @default("trial") // trial | active | grace | suspended | cancelled
  industry      String?
  gstin         String?
  timezone      String          @default("Asia/Kolkata")
  currency      String          @default("INR")
  isInternal    Boolean         @default(false) // true for Tenant #1 (your own company)
  deployment    String          @default("shared") // shared | dedicated | onprem
  dbConnectionRef String?       // for dedicated databases
  createdAt     DateTime        @default(now())
  domains       TenantDomain[]
  subscriptions Subscription[]
  overrides     TenantEntitlement[]
  workspaces    Workspace[]
  branches      Branch[]
  users         User[]
}

model TenantDomain {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  host       String  @unique // custom domain, e.g. crm.acme.com
  verified   Boolean @default(false)
}

model TenantEntitlement {
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  featureKey String
  enabled    Boolean // per-tenant override on top of the plan

  @@id([tenantId, featureKey])
}

model Subscription {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  period           String    // monthly | annual
  licences         Int
  status           String    // trialing | active | past_due | cancelled
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime
  gatewayRef       String?   // Razorpay subscription id
  invoices         PlatformInvoice[]
}

model PlatformInvoice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  number         String       @unique
  amountPaise    Int
  gstPaise       Int
  status         String       // draft | issued | paid | overdue | void
  issuedAt       DateTime
  paidAt         DateTime?
}

model UsageRecord {
  id        BigInt   @id @default(autoincrement())
  tenantId  String
  metric    String   // active_users | storage_gb | ai_credits | api_calls | whatsapp_msgs | call_minutes
  quantity  Decimal
  periodDay DateTime

  @@index([tenantId, metric, periodDay])
}

model PlatformUser {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  totpSecret   String? // encrypted TOTP secret
  totpEnabled  Boolean   @default(false)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  role         String  // owner | admin | sales | support | finance | tech
  isActive     Boolean @default(true)
}

// Login sessions for tenant users and platform staff. The refresh token is stored only as a SHA-256 hash.
model Session {
  id             String    @id @default(uuid())
  tenantId       String?   // null for platform staff sessions
  userId         String?
  platformUserId String?
  refreshHash    String    @unique
  prevRefreshHash String?  // previous token; presenting it again means the token was stolen
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  @@index([userId])
  @@index([platformUserId])
  @@index([prevRefreshHash])
}

// Security policy per organization (Workspace settings → Preferences / Security).
model OrganizationSetting {
  tenantId           String   @id
  sessionIdleMinutes Int      @default(480)
  ipAllowlist        String[] @default([])
  require2faRoles    String[] @default([]) // role names that must use two-factor auth
  loginMethods       String[] @default(["password", "google", "microsoft", "email_code"])
  allowedEmailDomains String[] @default([]) // empty = any domain (for Google / Microsoft / email-code login)
  leadIdentifier     String   @default("mobile") // Lead ID: the unique key that identifies a customer — mobile | email
  maxFailedLogins    Int      @default(5)
  lockMinutes        Int      @default(15)
  setupSkipped       String[] @default([]) // Setup Guide steps the admins chose to skip
  digestHour         Int      @default(9)  // local hour of the daily summary email
  reminderMinutes    Int      @default(15) // remind this many minutes before a task / follow-up
  recordingMode      String   @default("ubos") // cloud-call recordings: ubos (copied to UBOS storage) | provider (link only)
  recordingRetentionDays Int?  // shorter than the plan limit if the organization wants
  unknownCallerWorkspaceId String? // calls from numbers not in UBOS become leads here (null = keep as unmatched calls)
  dispositionRequired Boolean @default(false) // the phone app asks for a call outcome after every call
  updatedAt          DateTime @updatedAt
}

model SupportAccessGrant {
  id             String   @id @default(uuid())
  tenantId       String
  platformUserId String
  grantedByUserId String  // tenant admin who consented
  readOnly       Boolean  @default(true)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

// ═════════════════════════ TENANT: organization & workspaces ═════════════════════════

// A business line inside an organization, e.g. "Course/Software", "Logo Designing", "Vastu Consultation/Audit".
model Workspace {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  template  String?    // education | real_estate | consulting | design_services | software ...
  invoiceSeries String?
  gstin     String?    // when a business line bills under a separate entity
  isArchived Boolean   @default(false)
  // Who gets new leads from forms, integrations and imports (manual entries stay with their creator).
  assignmentMode    String   @default("round_robin") // round_robin | creator | fixed
  assignmentUserIds String[] @default([])            // round-robin pool / fixed owner (first id)
  assignmentCursor  Int      @default(0)
  stickyOwner       Boolean  @default(true)          // a returning customer goes back to their RM
  displayH1         String   @default("name")        // what lists and headers show as the title of a lead
  displayH2         String   @default("mobile")      // …and as the second line (name / mobile / email / city / cf:<key>)
  valueFieldKey     String?  // a number / amount lead field holding the deal value (for pipeline value and forecasts)
  quoteMaxDiscountPct Int    @default(10)              // a quote with more discount than this needs approval
  quoteTerms        String?  // default terms printed on quotes
  pipelines Pipeline[]
  leads     Lead[]
  packages  Package[]
  fields    LeadField[]
  options   WorkspaceOption[]

  @@unique([tenantId, slug])
}

// Custom lead field of one workspace (business line). Values live in Lead.customFields under `key`.
model LeadField {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  key         String    // stable machine name, e.g. "property_type"; never changes after creation
  label       String
  type        String    // text | textarea | number | currency | date | dropdown | multiselect | checkbox | phone | email | url
  options     String[]  @default([])
  required    Boolean   @default(false)
  position    Int       @default(0)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([workspaceId, key])
}

// Simple pick-lists per workspace: lead sources and lost reasons (later: call feedback, tags…).
model WorkspaceOption {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  kind        String    // lead_source | lost_reason | lead_status | call_disposition
  value       String    // stored on records (lead.source / lead.lostReason / lead.status / activity.disposition)
  label       String
  position    Int       @default(0)
  isArchived  Boolean   @default(false)
  connected   Boolean   @default(false) // call_disposition only: the customer was actually reached
  isDefault   Boolean   @default(false) // call_disposition: used when a call connects; lead_status: given to new leads

  @@unique([workspaceId, kind, value])
}

// A process inside a workspace, e.g. Education → Admissions / Renewals; Vastu → Consultation / Site Audit.
model Pipeline {
  id          String      @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  name        String
  position    Int         @default(0)
  stages      LeadStage[]
  leads       Lead[]
}

model LeadStage {
  id         String   @id @default(uuid())
  tenantId   String
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  position   Int
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  color      String?             // hex colour on the stage board
  slaDays    Int?                // warn when a lead stays longer than this in the stage
  requiredFieldKeys String[] @default([]) // custom fields that must be filled before entering this stage
  setStatus  String?             // lead status applied automatically on entering the stage
  followUpDays Int?              // follow-up created automatically N days after entering the stage
  winProbability Int?            // % chance an open lead in this stage is won (forecast); null = default by position
}

// Routes a source (form, WhatsApp number, CallerDesk number, webhook, sheet) to a workspace + pipeline.
model LeadSourceMapping {
  id          String @id @default(uuid())
  tenantId    String
  sourceType  String // facebook_form | whatsapp_number | callerdesk_number | webhook | google_sheet | website_form
  sourceRef   String // form id / phone number / endpoint key / sheet id
  workspaceId String
  pipelineId  String

  @@unique([tenantId, sourceType, sourceRef])
}

model Branch {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  departments Department[]
}

model Department {
  id       String @id @default(uuid())
  tenantId String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  name     String
  teams    Team[]
}

model Team {
  id           String     @id @default(uuid())
  tenantId     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  workspaceId  String?    // sales teams usually belong to one business line
  name         String
  members      User[]
}

model User {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  teamId        String?
  team          Team?      @relation(fields: [teamId], references: [id])
  reportsToId   String?
  reportsTo     User?      @relation("Hierarchy", fields: [reportsToId], references: [id])
  directReports User[]     @relation("Hierarchy")
  name          String
  email         String
  username      String?
  mobile        String?
  passwordHash  String
  totpSecret    String?    // encrypted
  totpEnabled   Boolean    @default(false)
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  passwordChangedAt DateTime?
  mustChangePassword Boolean @default(false)
  isActive      Boolean    @default(true)
  digestEnabled Boolean    @default(true)   // daily summary email
  acceptingLeads Boolean   @default(true)   // off = skipped by automatic assignment (manual transfer still possible)
  lastDigestAt  DateTime?
  roles         UserRole[]
  employee      Employee?
  createdAt     DateTime   @default(now())

  @@unique([tenantId, email])
  @@unique([tenantId, username])
}

// One-time login codes sent by email ("Sign in with email code"). Only a hash of the code is stored.
model LoginCode {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
}

// ═════════════════════════ Roles & permissions (multi-role, per workspace) ═════════════════════════

enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  BRANCH
  WORKSPACE
  ORGANIZATION
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String           // any custom name, e.g. "Content Creator"
  isTemplate  Boolean          @default(false)
  permissions RolePermission[]
  fieldRules  FieldRule[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique // e.g. "crm.lead.export"
  roles RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id])
  scope         DataScope  @default(OWN)
  isDeny        Boolean    @default(false)
  maxExportRows Int?

  @@id([roleId, permissionId])
}

model FieldRule {
  id         String @id @default(uuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id])
  entity     String // e.g. "customer"
  field      String // e.g. "mobile"
  visibility String // hidden | masked | visible | editable
}

// A user can hold many roles; each assignment is for one workspace or the whole organization (workspaceId = null).
model UserRole {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  workspaceId  String?
  branchId     String?
  departmentId String?
  validFrom    DateTime?
  validTo      DateTime?
  isPrimary    Boolean   @default(false) // decides default dashboard

  @@unique([userId, roleId, workspaceId, branchId, departmentId])
}

// ═════════════════════════ CRM ═════════════════════════

// Shared across all workspaces of the organization.
model Customer {
  id           String            @id @default(uuid())
  tenantId     String
  code         String            // human-readable Customer ID
  name         String
  mobile       String?           // E.164; unique per organization among active (unmerged) customers
  alternateMobiles String[]      @default([])
  email        String?
  alternateEmails String[]       @default([])
  whatsappOptOut  Boolean        @default(false) // replied STOP: no templates or broadcasts any more
  city         String?
  panEncrypted String?
  panLast4     String?
  panHash      String?           // keyed hash, lets us find the same PAN without decrypting
  aadhaarLast4 String?           // full number never stored by default
  primaryRmId  String?
  customFields Json?
  mergedIntoId String?           // set when this record was merged into another customer
  mergedAt     DateTime?
  leads        Lead[]
  packages     CustomerPackage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, mobile])
  @@index([tenantId, email])
  @@index([tenantId, panHash])
}

// History of customer merges; keeps what is needed to undo a merge.
model CustomerMerge {
  id              String    @id @default(uuid())
  tenantId        String
  primaryId       String
  duplicateId     String
  movedLeadIds    String[]
  movedPackageIds String[]
  filledFields    Json      // fields copied from the duplicate onto the primary (reverted on undo)
  reason          String?
  mergedById      String
  createdAt       DateTime  @default(now())
  undoneAt        DateTime?
  undoneById      String?

  @@index([tenantId, primaryId])
  @@index([tenantId, duplicateId])
}

// "These two are different people" — hides the pair from duplicate suggestions.
model CustomerDuplicateDismissal {
  id            String   @id @default(uuid())
  tenantId      String
  customerAId   String   // the smaller id of the pair
  customerBId   String
  dismissedById String
  createdAt     DateTime @default(now())

  @@unique([tenantId, customerAId, customerBId])
}

model Lead {
  id              String     @id @default(uuid())
  tenantId        String
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  pipelineId      String
  pipeline        Pipeline   @relation(fields: [pipelineId], references: [id])
  stageId         String
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  source          String     // website, facebook, whatsapp, google_sheets, referral, api, manual, cross_sell...
  referredFromLeadId String? // cross-sell from another workspace
  ownerId         String?
  assignedAt      DateTime?
  status          String?    // lead status value (Hot / Warm / Cold …) from the workspace list; separate from stage
  rating          Int?
  customFields    Json?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  firstResponseAt DateTime?
  lastActivityAt  DateTime?
  lastDisposition String?
  nextFollowUpAt  DateTime?  // earliest open follow-up, kept in sync for fast "due today" lists
  stageChangedAt  DateTime   @default(now()) // for stage SLA ("in this stage for 4 days")
  score           Int        @default(0)     // lead score, e.g. from custom-action scores
  labelIds        String[]   @default([])    // Label ids
  teamMembers     LeadTeamMember[]
  importId        String?
  followUps       FollowUp[]
  activities      LeadActivity[]

  @@index([tenantId, workspaceId, pipelineId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, nextFollowUpAt])
}

model FollowUp {
  id          String    @id @default(uuid())
  tenantId    String
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  dueAt       DateTime
  note        String?
  doneAt      DateTime?
  outcome     String?
  userId      String
  createdById String?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId, doneAt, dueAt])
  @@index([leadId])
}

// Everything that happens on a lead: calls (with disposition), remarks, status changes, assignments, imports.
model LeadActivity {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  type        String    // call | remark | status | assignment | stage | follow_up | import
  disposition String?   // call: workspace call_disposition value
  connected   Boolean?  // call: reached the customer
  durationSec Int?
  remark      String?
  data        Json?     // extra details (old/new values etc.)
  userId      String?
  createdAt   DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
}

// One bulk upload (CSV / Excel) with its outcome.
model LeadImport {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  fileName    String
  total       Int
  created     Int
  linked      Int      // rows that matched an existing customer
  skipped     Int      // duplicates in this business line that were skipped
  failed      Int
  errors      Json     // [{ row, message }]
  createdById String
  createdAt   DateTime @default(now())

  @@index([tenantId, workspaceId, createdAt])
}

// Products, services and packages sold by a business line.
model Package {
  id          String            @id @default(uuid())
  tenantId    String
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  name        String            // Elite, BSP, NME, VPM, Logo Basic, Vastu Audit...
  code        String?           // SKU / short code
  description String?
  category    String?
  unit        String            @default("unit")
  mrpPaise    Int
  gstRate     Decimal
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  sales       CustomerPackage[]
  priceItems  PriceListItem[]
}

// A price list of a business line (e.g. "Standard", "Festive offer"); prices fall back to the product MRP.
model PriceList {
  id          String          @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  isDefault   Boolean         @default(false)
  validFrom   DateTime?
  validTo     DateTime?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  items       PriceListItem[]

  @@index([tenantId, workspaceId])
}

model PriceListItem {
  id            String    @id @default(uuid())
  tenantId      String
  priceListId   String
  priceList     PriceList @relation(fields: [priceListId], references: [id])
  packageId     String
  package       Package   @relation(fields: [packageId], references: [id])
  pricePaise    Int
  minPricePaise Int?      // lowest price a rep may offer without approval

  @@unique([priceListId, packageId])
}

// Quote / proposal made from a lead.
model Quote {
  id            String      @id @default(uuid())
  tenantId      String
  workspaceId   String
  leadId        String
  customerId    String
  number        String      // Q-2026-0001
  status        String      @default("draft") // draft | pending_approval | approved | sent | accepted | rejected
  priceListId   String?
  validUntil    DateTime?
  subtotalPaise Int         @default(0) // list value before discount
  discountPaise Int         @default(0)
  taxPaise      Int         @default(0)
  totalPaise    Int         @default(0)
  notes         String?
  terms         String?
  needsApproval Boolean     @default(false)
  approvalId    String?
  createdById   String
  sentAt        DateTime?
  decidedAt     DateTime?   // accepted / rejected by the customer
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  items         QuoteItem[]

  @@unique([tenantId, number])
  @@index([tenantId, leadId])
}

model QuoteItem {
  id             String  @id @default(uuid())
  tenantId       String
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id])
  packageId      String?
  name           String
  qty            Int     @default(1)
  listPricePaise Int     // price-list / MRP unit price
  pricePaise     Int     // offered unit price
  gstRate        Float   @default(0)
  position       Int     @default(0)
}

// Anything waiting for a manager's yes / no: quote discounts, process steps that need sign-off.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  workspaceId   String
  leadId        String?
  kind          String    // quote_discount | process_step
  entityId      String    // quote id / step-run id
  title         String
  details       Json?
  status        String    @default("pending") // pending | approved | rejected | cancelled
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
  @@index([tenantId, entityId])
}

// What happens after a sale: ordered steps with owners, forms, payment gates and approvals (per business line).
model ProcessTemplate {
  id          String        @id @default(uuid())
  tenantId    String
  workspaceId String
  name        String
  description String?
  trigger     String        @default("won") // won (starts when a lead is won) | manual
  packageIds  String[]      @default([])    // only for these products (empty = any sale)
  isArchived  Boolean       @default(false)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  steps       ProcessStep[]

  @@index([tenantId, workspaceId])
}

model ProcessStep {
  id               String          @id @default(uuid())
  tenantId         String
  templateId       String
  template         ProcessTemplate @relation(fields: [templateId], references: [id])
  position         Int
  name             String
  instructions     String?
  assignTo         String          @default("lead_owner") // lead_owner | user | role
  assigneeUserId   String?
  ownerRoleId      String?         // responsible role (assignTo = role: first available person with it)
  dueDays          Int?            // due this many days after the step starts
  fields           Json            @default("[]") // [{ key, label, type, options, required }]
  minPaymentPct    Int?            // step can only be completed once this % of the deal value is received
  requiresApproval Boolean         @default(false)
  access           Json            @default("{}") // roleId → edit | view | none (roles not listed: view)
  isArchived       Boolean         @default(false)
}

// One customer's journey through a process template.
model ProcessRun {
  id              String    @id @default(uuid())
  tenantId        String
  workspaceId     String
  templateId      String
  leadId          String
  customerId      String
  quoteId         String?
  status          String    @default("active") // active | completed | cancelled
  dealValuePaise  Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  cancelledReason String?
  rating          Int?      // customer rating 1-5 recorded at completion
  ratingNote      String?
  createdById     String
  steps           StepRun[]

  @@index([tenantId, leadId])
  @@index([tenantId, workspaceId, status])
}

model StepRun {
  id            String     @id @default(uuid())
  tenantId      String
  runId         String
  run           ProcessRun @relation(fields: [runId], references: [id])
  stepId        String
  position      Int
  status        String     @default("pending") // pending | active | awaiting_approval | done
  assigneeId    String?
  dueAt         DateTime?
  data          Json       @default("{}")
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  locked        Boolean    @default(false) // done steps are locked; unlocking needs process.unlock and a reason
  approvalId    String?
  sentBackCount Int        @default(0)
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([runId])
  @@index([tenantId, assigneeId, status])
}

// Money received from a customer: token, instalments, balance. Never deleted — a wrong entry is voided.
model Payment {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String
  customerId  String
  leadId      String?
  runId       String?
  packageId   String?
  amountPaise Int
  kind        String    @default("instalment") // token | instalment | balance | full
  mode        String    @default("upi")        // cash | upi | card | bank | cheque | online
  reference   String?
  receivedAt  DateTime  @default(now())
  note        String?
  source      String    @default("manual")     // manual | rule (payment rules) | gateway (1.7)
  isVoided    Boolean   @default(false)
  voidReason  String?
  voidedById  String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, runId])
  @@index([tenantId, customerId])
}

// Decides what an incoming payment is: a new sale (opens a won lead + process) or an instalment of a running one.
model PaymentRule {
  id             String   @id @default(uuid())
  tenantId       String
  workspaceId    String
  name           String
  position       Int      @default(0)
  minAmountPaise Int?
  maxAmountPaise Int?
  packageIds     String[] @default([])
  action         String   // new_sale | instalment
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([tenantId, workspaceId])
}

// Extra people working on a lead (designer, consultant, accounts) with a role label; they can see the lead.
model LeadTeamMember {
  id        String    @id @default(uuid())
  tenantId  String
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  userId    String
  roleLabel String
  addedById String
  createdAt DateTime  @default(now())
  removedAt DateTime?

  @@index([tenantId, userId])
  @@index([leadId])
}

// Temporary cover while someone is away: their new leads go to the cover person, who also sees their leads.
model UserCover {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  coverUserId String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  createdById String
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, coverUserId])
}

model CustomerPackage {
  id                String   @id @default(uuid())
  tenantId          String
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  packageId         String
  package           Package  @relation(fields: [packageId], references: [id])
  mrpPaise          Int
  offerPricePaise   Int
  discountPaise     Int
  secondaryRmId     String?
  secondarySplitPct Int?
  collectionStatus  String   @default("pending") // pending | partial | paid | refunded
  soldAt            DateTime @default(now())
}

// ═════════════════════════ Integrations (per tenant) ═════════════════════════

model IntegrationConnection {
  id              String    @id @default(uuid())
  tenantId        String
  workspaceId     String?   // e.g. a WhatsApp number dedicated to one business line
  key             String    // callerdesk, whatsapp, google_sheets, razorpay...
  status          String    @default("inactive") // active | paused | inactive
  configEncrypted String?   // encrypted with the tenant's data key
  activatedById   String?
  activatedAt     DateTime?
  lastEventAt     DateTime?

  @@index([tenantId, key])
}

// Every incoming webhook / form / API / sheet record, kept so it can be inspected and replayed.
model WebhookInbox {
  id             String    @id @default(uuid())
  tenantId       String?
  integrationKey String    // website_api, indiamart, form:<slug>, api, google_sheets …
  headers        Json
  body           String
  status         String    @default("received") // received | processed | failed | duplicate | skipped
  attempts       Int       @default(0)
  receivedAt     DateTime  @default(now())
  externalId     String?   // sender's id (portal enquiry id, sheet row hash, Idempotency-Key) — the same one is never processed twice
  outcome        String?   // created | linked | add_remark | update_blank | overwrite | skip | rejected
  leadId         String?
  error          String?
  processedAt    DateTime?

  @@index([tenantId, integrationKey, receivedAt])
  @@index([tenantId, integrationKey, externalId])
}

// Organization API keys for the public API. Only a hash of the key is stored; it is shown once.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  prefix      String    // first characters, shown in lists
  keyHash     String    @unique
  scopes      String[]  // leads:read, leads:write, customers:read, meta:read
  workspaceId String?   // limited to one business line (null = all)
  createdById String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// Outgoing webhooks: UBOS calls another system when something happens (signed with HMAC).
model WebhookSubscription {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  url             String
  events          String[]
  workspaceId     String?
  secretEncrypted String
  isActive        Boolean   @default(true)
  createdById     String
  failureCount    Int       @default(0) // consecutive failures; paused after too many
  lastDeliveryAt  DateTime?
  lastStatus      Int?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  tenantId       String
  subscriptionId String
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  responseStatus Int?
  responseBody   String?
  error          String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([tenantId, subscriptionId, createdAt])
}

// Web-to-lead form of a business line: hosted page + embed code.
model LeadForm {
  id            String   @id @default(uuid())
  tenantId      String
  workspaceId   String
  name          String
  slug          String
  title         String
  description   String?
  fields        Json     // [{ target: name | mobile | email | city | remark | cf:<key>, label, required, placeholder }]
  submitLabel   String   @default("Submit")
  thankYou      String   @default("Thank you! We will contact you soon.")
  redirectUrl   String?
  source        String   @default("website")
  duplicateMode String   @default("add_remark")
  color         String   @default("#5b3cc4")
  isActive      Boolean  @default(true)
  isArchived    Boolean  @default(false)
  submissions   Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([tenantId, slug])
}

// ═════════════════════════ HRMS & Assets (organization level) ═════════════════════════

model Employee {
  id            String            @id @default(uuid())
  tenantId      String
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id])
  employeeCode  String
  joiningDate   DateTime
  probationEnd  DateTime?
  exitDate      DateTime?
  status        String            @default("onboarding") // onboarding | active | notice | exited
  leaveRequests LeaveRequest[]
  assets        AssetAssignment[]
}

model LeaveRequest {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  fromDate   DateTime
  toDate     DateTime
  status     String   @default("pending")
  approverId String?
}

model Asset {
  id          String            @id @default(uuid())
  tenantId    String
  tag         String
  category    String            // laptop, mobile, sim, headset...
  serialNo    String?
  costPaise   Int?
  warrantyEnd DateTime?
  condition   String            @default("good")
  assignments AssetAssignment[]
}

model AssetAssignment {
  id              String    @id @default(uuid())
  tenantId        String
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  issuedAt        DateTime  @default(now())
  acknowledgedAt  DateTime?
  returnedAt      DateTime?
  returnCondition String?
}

// ═════════════════════════ Audit (append-only) ═════════════════════════

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  // null for platform-level events
  workspaceId String?
  actorType   String   // tenant_user | platform_user | system | api_key
  actorId     String?
  ip          String?
  entity      String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  reason      String?
  prevHash    String?
  hash        String
  createdAt   DateTime @default(now())

  @@index([tenantId, entity, entityId])
}

// Custom action: a small form run from a lead (e.g. "Course Details"); answers go on the timeline and add to the lead score.
model CustomAction {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String?   // null = available in every workspace
  code        Int       // human-friendly code (1001, 1002…)
  name        String
  description String?
  score       Int       @default(0)
  fields      Json      // [{ key, label, type, options, required }] — same types as custom lead fields
  isArchived  Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([tenantId, code])
}

model LeadActionResponse {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  leadId      String
  actionId    String
  answers     Json
  score       Int
  userId      String
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([actionId])
}

// What the platform sells: licences (per user) and one-time services. Managed by the Platform Owner.
model PlatformProduct {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  kind              String   // licence | service
  planCode          String?  // licence: the plan it activates
  priceMonthlyPaise Int?     // licence: per user per month
  priceOncePaise    Int?     // service: one-time price
  annualDiscountPct Int      @default(0)
  isActive          Boolean  @default(true)
  position          Int      @default(0)
}

// ── Slice 1.5c: productivity & views ──

/** Coloured label (tag) for leads; per business line or organization-wide (workspaceId = null). */
model Label {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  color       String   @default("#5b3cc4")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, workspaceId])
}

/** Smart view: saved lead filters, columns and layout; personal or shared with roles. */
model SavedView {
  id            String   @id @default(uuid())
  tenantId      String
  ownerId       String
  workspaceId   String?
  name          String
  query         Json     // filters + sort as on the leads page
  columns       String[] @default([])
  layout        String   @default("list") // list | board
  sharedRoleIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, ownerId])
}

/** Task, meeting or planned call — on a lead or on its own. */
model Task {
  id          String    @id @default(uuid())
  tenantId    String
  workspaceId String?
  leadId      String?
  type        String    @default("task") // task | meeting | call
  title       String
  notes       String?
  dueAt       DateTime
  durationMin Int?
  location    String?   // address or meeting link
  assigneeId  String
  createdById String
  mentionIds  String[]  @default([])
  doneAt      DateTime?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, assigneeId, doneAt, dueAt])
  @@index([leadId])
}

/** In-app notification (mentions, reminders, assignments). */
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String    // mention | reminder | assignment | digest
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
}

/** Target for a metric per period, for a person, a team or the whole business line / organization. */
model Goal {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String?
  name        String
  metric      String   // analytics metric key, e.g. won, calls, won_value
  period      String   @default("month") // week | month | quarter
  target      Int      // in the metric's unit (paise for amounts)
  userId      String?
  teamId      String?
  createdById String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
}

/** Call script shown in the Log-call panel, for a stage or the whole business line. */
model CallScript {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  stageId     String?
  title       String
  body        String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

/** "Email me this dashboard": each person subscribes for themselves, so numbers follow their own access. */
model DashboardSubscription {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  dashboardId String    // a saved dashboard id or "tpl:<key>"
  frequency   String    @default("daily") // daily | weekly (Mondays)
  hour        Int       @default(9)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, dashboardId])
}

// A saved dashboard: widgets with their metric, chart and size. Personal, or shared with roles / teams / business lines / people.
model Dashboard {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  ownerId            String
  widgets            Json     // WidgetConfig[] (see @ubos/shared analytics)
  range              String   @default("this_month")
  sharedRoleIds      String[] @default([])
  sharedTeamIds      String[] @default([])
  sharedWorkspaceIds String[] @default([])
  sharedUserIds      String[] @default([])
  defaultForRoleIds  String[] @default([]) // landing dashboard for these roles
  isLocked           Boolean  @default(false) // only the owner / dashboard managers may change it
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, ownerId])
}

// An organization's purchase: licences for a billing cycle and/or services. Paid via gateway later; marked paid manually for now.
model TenantOrder {
  id            String    @id @default(uuid())
  tenantId      String
  number        String    @unique
  cycle         String    // quarterly | annual | one_time
  items         Json      // [{ productCode, name, kind, quantity, unitPaise, amountPaise }]
  subtotalPaise Int
  gstPaise      Int
  totalPaise    Int
  status        String    @default("pending") // pending | paid | cancelled
  createdById   String
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  paymentRef    String?
  note          String?

  @@index([tenantId, createdAt])
}

// ═════════════════════════ Calling (Phase 2) ═════════════════════════

// Every call, whatever the channel (SIM phone app, cloud provider, logged by hand). The same externalId is stored once.
model Call {
  id               String    @id @default(uuid())
  tenantId         String
  externalId       String    // deviceId:callLogId:startTime (SIM) / provider call id (cloud) / activity id (manual)
  channel          String    // sim | cloud | manual
  provider         String?   // callerdesk …
  direction        String    // outbound | inbound
  phone            String    // the other party (E.164 when it could be read)
  userId           String?
  deviceId         String?
  workspaceId      String?
  leadId           String?   // null = unmatched (number not in UBOS yet)
  customerId       String?
  activityId       String?   // the call on the lead's journey
  startedAt        DateTime
  ringSec          Int       @default(0)
  talkSec          Int       @default(0)
  answered         Boolean   @default(false)
  disposition      String?
  remark           String?
  recordingStatus  String    @default("none") // none | uploading | ready | link | deleted
  recordingKey     String?   // storage key (encrypted file)
  recordingLinkEnc String?   // provider recording URL, encrypted (recording mode "link only")
  recordingBytes   Int?
  recordingMime    String?
  recordingTotal   Int?      // expected size while uploading
  clientUpdatedAt  DateTime? // edit time on the phone (latest edit wins)
  receivedAt       DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, startedAt])
  @@index([tenantId, leadId])
  @@index([tenantId, userId, startedAt])
}

// A paired phone (SIM-calling app). Only a hash of its token is stored.
model Device {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  name         String
  platform     String    @default("android")
  appVersion   String?
  tokenHash    String    @unique
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?
  pendingCalls Int       @default(0) // reported by the app: calls waiting to sync
  revokedAt    DateTime?
  revokedById  String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId])
}

model PairingCode {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, codeHash])
}

// "Call" pressed on the web: the paired phone picks it up and dials.
model DialRequest {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  leadId    String
  phone     String
  status    String    @default("pending") // pending | picked | expired
  createdAt DateTime  @default(now())
  pickedAt  DateTime?

  @@index([tenantId, userId, status])
}

// ═════════════════════════ WhatsApp (Phase 2.3) ═════════════════════════

// One chat with one WhatsApp number (the customer's), on the organization's business number.
model Conversation {
  id            String    @id @default(uuid())
  tenantId      String
  channel       String    @default("whatsapp")
  waId          String    // customer's number as WhatsApp sends it (digits, with country code)
  workspaceId   String?
  customerId    String?
  leadId        String?
  assigneeId    String?
  status        String    @default("open") // open | closed
  lastMessageAt DateTime  @default(now())
  lastInboundAt DateTime? // free replies are allowed for 24 hours after this
  unread        Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([tenantId, channel, waId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, leadId])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  direction      String   // in | out
  type           String   @default("text") // text | template | image | document | audio | other
  body           String?
  templateName   String?
  waMessageId    String?  // WhatsApp's id (same id never stored twice)
  status         String   @default("received") // received | queued | sent | delivered | read | failed
  error          String?
  userId         String?
  broadcastId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([tenantId, waMessageId])
  @@index([conversationId, createdAt])
}

// Approved WhatsApp message templates ({{1}}, {{2}} … placeholders filled from lead fields when sending).
model MessageTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  channel     String   @default("whatsapp")
  name        String   // as approved in WhatsApp Manager
  language    String   @default("en")
  category    String   @default("marketing") // marketing | utility
  body        String
  variables   String[] @default([]) // what fills {{1}}, {{2}}…: name | mobile | city | owner | cf:<key> | text:<fixed>
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, channel, name, language])
}

model Broadcast {
  id          String   @id @default(uuid())
  tenantId    String
  templateId  String
  name        String
  total       Int      @default(0)
  sent        Int      @default(0)
  skipped     Int      @default(0) // opted out / no number
  failed      Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
}
