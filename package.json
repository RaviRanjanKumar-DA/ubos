{
  "name": "ubos",
  "private": true,
  "version": "0.1.0",
  "description": "UBOS — Unified Business Operating System (multi-tenant SaaS)",
  "workspaces": [
    "packages/shared",
    "packages/database",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:generate": "npm run generate -w @ubos/database",
    "db:migrate": "npm run migrate -w @ubos/database",
    "db:seed": "npm run seed -w @ubos/database",
    "db:demo": "npm run seed -w @ubos/database && npm run demo -w @ubos/database",
    "build": "npm run build -w @ubos/shared && npm run build -w @ubos/api && npm run build -w @ubos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @ubos/api",
    "dev:web": "npm run dev -w @ubos/web",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:users": "node scripts/verify-users.mjs",
    "verify:settings": "node scripts/verify-workspace-settings.mjs",
    "verify:customers": "node scripts/verify-customers.mjs",
    "verify:leadwork": "node scripts/verify-leadwork.mjs",
    "verify:admin": "node scripts/verify-settings-admin.mjs",
    "verify:dashboards": "node scripts/verify-dashboards.mjs",
    "verify:productivity": "node scripts/verify-productivity.mjs",
    "verify:process": "node scripts/verify-process.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "verify:calling": "node scripts/verify-calling.mjs",
    "verify:whatsapp": "node scripts/verify-whatsapp.mjs",
    "verify:messaging": "node scripts/verify-messaging.mjs",
    "verify:automation": "node scripts/verify-automation.mjs",
    "verify:campaigns": "node scripts/verify-campaigns.mjs",
    "verify:helpdesk": "node scripts/verify-helpdesk.mjs",
    "verify:connected": "node scripts/verify-connected.mjs",
    "verify:leadrules": "node scripts/verify-leadrules.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
